# GaiA AI Market에서 발급받은 External Gateway 전체 주소
GAIA_EXTERNAL_AGENT_URL=https://example.skhynix.com/v2/agents/<agentId>/external/

# GaiA AI Market에서 발급받은 External 인증키
GAIA_EXTERNAL_API_KEY=

# 테스트할 사용자 사번 (숫자 7자리)
GAIA_TEST_USER_ID=2069026

# 비우면 브라우저 탭마다 자동 세션을 생성합니다. 고정 세션을 테스트할 때만 입력하세요.
GAIA_TEST_SESSION_ID=

# 일반적으로 변경하지 않습니다.
GAIA_A2A_METHOD=message/stream
GAIA_REQUEST_TIMEOUT_SECONDS=300
GAIA_VERIFY_SSL=true
