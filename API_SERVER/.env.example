# Public DNS address returned by POST /reports. Do not use 0.0.0.0 here.
API_SERVER_PUBLIC_BASE_URL=http://aaa.test.com

# TCP port used by app.py for both data-ref download and HTML report routes.
# For a simple local deployment, keep this port equal to the port in
# API_SERVER_PUBLIC_BASE_URL.
API_SERVER_PORT=5000

# MongoDB connection for data_ref downloads.  Report storage uses this same
# connection by default, unless the API_SERVER_REPORT_MONGODB values below are set.
API_SERVER_MONGODB_URI=
API_SERVER_MONGODB_DATABASE=datagov
API_SERVER_RESULT_COLLECTION=agent_v4_result_store

# HTML reports: HTML and metadata are stored together in this one collection.
# Leave URI/database empty to reuse API_SERVER_MONGODB_URI/database above.
API_SERVER_REPORT_MONGODB_URI=
API_SERVER_REPORT_MONGODB_DATABASE=
API_SERVER_REPORT_COLLECTION=report_save_db

API_SERVER_PREVIEW_LIMIT=100
API_SERVER_MAX_DOWNLOAD_BYTES=67108864
REPORT_DEFAULT_TTL_HOURS=24
REPORT_MAX_TTL_HOURS=168
REPORT_USE_ACCESS_TOKEN=false
