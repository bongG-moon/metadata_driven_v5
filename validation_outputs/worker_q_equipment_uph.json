he pandas_execution_plan\nselect_columns = [\n    \"EQUIP_ID\",\n    \"EQUIP_MODEL\",\n    \"OPER_NAME\",\n    \"RECIPE_ID\",\n    \"UPH\"\n]\n\n# Filter for columns that actually exist in the joined DataFrame\n# This makes the code robust against missing columns in case of schema changes\nfinal_columns = [col for col in select_columns if col in joined_data.columns]\n\n# Select the required columns\nresult = joined_data[final_columns].copy()\n\n# Apply output contract policies for null values\n# Dimension columns (grain_columns): fill NaN/blank with empty string\ndimension_cols = [\"EQUIP_ID\", \"EQUIP_MODEL\", \"OPER_NAME\", \"RECIPE_ID\"]\nfor col in dimension_cols:\n    if col in result.columns:\n        # Convert to string to handle potential numeric NaNs and ensure consistent type for empty string replacement\n        result[col] = result[col].astype(str).replace('nan', '').replace(r\"^\\s*$\", \"\", regex=True)\n\n# Metric columns (metric_columns): fill NaN with 0\nmetric_cols = [\"UPH\"]\nfor col in metric_cols:\n    if col in result.columns:\n        # Convert to numeric, coercing errors, then fill NaN with 0\n        result[col] = pd.to_numeric(result[col], errors='coerce').fillna(0)\n\n# Ensure the final result columns are in the specified order from output_contract.required_columns\noutput_contract_order = [\"EQUIP_ID\", \"EQUIP_MODEL\", \"OPER_NAME\", \"RECIPE_ID\", \"UPH\"]\nresult_cols_ordered = [col for col in output_contract_order if col in result.columns]\nresult = result[result_cols_ordered]",
