# Select exactly one: preview (safe sample response only) or api (external Flow API call).
PTMORE_METADATA_API_MODE=preview

# A single endpoint can serve all three metadata types.  Set this OR use the
# type-specific endpoints below when each rev_2 Flow has its own Run API URL.
PTMORE_METADATA_API_URL=
PTMORE_METADATA_TABLE_CATALOG_API_URL=
PTMORE_METADATA_MAIN_FLOW_FILTER_API_URL=
PTMORE_METADATA_DOMAIN_API_URL=

# HTTP authentication.  Leave a value blank only when the receiving API does
# not require it.  Do not commit the real .env file.
PTMORE_METADATA_API_AUTH_HEADER=X-API-Key
PTMORE_METADATA_API_AUTH_KEY=
PTMORE_METADATA_API_USER_ID_HEADER=X-Gaia-User-Id
PTMORE_METADATA_API_USER_ID=
PTMORE_METADATA_API_BEARER_TOKEN=
PTMORE_METADATA_API_EXTRA_HEADERS_JSON={}
PTMORE_METADATA_API_TIMEOUT_SECONDS=60
PTMORE_METADATA_API_VERIFY_TLS=true

# `langflow` sends input_value plus component tweaks to a Langflow Run API.
# Use `direct` only if the configured endpoint expects the portal JSON shape.
PTMORE_METADATA_API_PAYLOAD_MODE=langflow
PTMORE_METADATA_API_INPUT_TYPE=chat
# `any` is required to receive the `10 ... API 응답 생성기` terminal result.
PTMORE_METADATA_API_OUTPUT_TYPE=any

# Optional Flow node override. Defaults already use the stable Korean display
# names from rev_2, so normally leave this as {}. If an operator renamed a
# node, set only that Flow's values here; a display name or node ID both work.
PTMORE_METADATA_FLOW_COMPONENT_MAP_JSON={}

# Mongo values are passed as Snapshot/Writer tweaks only when explicitly
# enabled in API mode. They are never returned by status APIs.
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION_PREFIX=agent_v4_
# Optional exact collection-name overrides instead of the prefix-derived names.
PTMORE_METADATA_MONGODB_COLLECTION_MAP_JSON={}
# Send Mongo URI/DB values as trusted-internal Langflow tweaks only when this is true.
PTMORE_METADATA_SEND_MONGODB_TWEAKS=false
