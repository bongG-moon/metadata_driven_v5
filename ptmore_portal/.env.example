# PTMORE PKG Agent Portal 환경설정 예시
# 이 파일을 .env로 복사한 뒤 필요한 값만 입력합니다.
# API 키와 DB 비밀번호는 이 예시 파일에 저장하지 않습니다.

# preview: 화면/더미 데이터 확인, api: 실제 Flow API 호출
PTMORE_METADATA_API_MODE=preview

# 공통 메타데이터 API 주소 (사용 시 유형별 URL은 비워 둠)
PTMORE_METADATA_API_URL=

# 유형별 Langflow Run API 주소
# 예: https://<LANGFLOW_HOST>/api/v1/run/<flow-id-or-endpoint-name>
PTMORE_METADATA_TABLE_CATALOG_API_URL=
PTMORE_METADATA_MAIN_FLOW_FILTER_API_URL=
PTMORE_METADATA_DOMAIN_API_URL=

# API 인증 정보 (실제 값은 .env 또는 비밀관리 도구에 입력)
PTMORE_METADATA_API_AUTH_HEADER=X-Gaia-Auth-Key
PTMORE_METADATA_API_AUTH_KEY=
PTMORE_METADATA_API_BEARER_TOKEN=
PTMORE_METADATA_API_EXTRA_HEADERS_JSON={}

# API 호출 설정
PTMORE_METADATA_API_TIMEOUT_SECONDS=300
PTMORE_METADATA_API_VERIFY_TLS=true

# Flow 요청 형식 (일반적으로 langflow 사용)
PTMORE_METADATA_API_PAYLOAD_MODE=langflow
PTMORE_METADATA_API_INPUT_TYPE=chat
PTMORE_METADATA_API_OUTPUT_TYPE=any

# Flow 노드 이름을 변경한 경우에만 JSON으로 매핑 입력
PTMORE_METADATA_FLOW_COMPONENT_MAP_JSON={}

# Portal 설정 저장 및 실제 메타데이터 조회용 MongoDB
# 실제 목록을 읽을 때는 실제 메타데이터 DB 이름으로 변경합니다.
# GAIA API 호출 권한 사번은 관리자 설정 화면에서 관리됩니다.
MONGODB_URI=
MONGODB_DATABASE=datagov_test
MONGODB_COLLECTION_PREFIX=agent_v4_test_

# 포털 관리·스케줄 컬렉션 이름
PTMORE_PORTAL_SETTINGS_COLLECTION=portal_settings
PTMORE_PORTAL_AUDIT_COLLECTION=portal_audit_log
PTMORE_SCHEDULE_COLLECTION=portal_schedules
PTMORE_SCHEDULE_RUN_COLLECTION=portal_schedule_runs
# 현재 스케줄 CRUD는 아직 연결 전입니다. 위 두 스케줄 값은 향후 저장 대상 이름입니다.

# 실제 메타데이터 목록 조회 (읽기 전용, 기본 비활성)
PTMORE_METADATA_LIVE_READ_MODE=configured
# 실조회할 컬렉션을 유형별로 지정할 때만 입력
PTMORE_METADATA_LIVE_COLLECTION_MAP_JSON={}

# 컬렉션 이름을 직접 지정해야 할 때만 JSON으로 입력
PTMORE_METADATA_MONGODB_COLLECTION_MAP_JSON={}

# false: 원격 Flow의 MongoDB 설정 사용, true: 아래 MongoDB 정보를 Flow에 전달
PTMORE_METADATA_SEND_MONGODB_TWEAKS=false

# 사용 이력: preview(더미) / phoenix(실제 Phoenix 조회)
PTMORE_USAGE_HISTORY_MODE=preview

# Phoenix 연결 정보 (실제 값은 .env 또는 비밀관리 도구에 입력)
PTMORE_PHOENIX_ENDPOINT=
PTMORE_PHOENIX_API_KEY=

# 조회할 Phoenix 프로젝트 이름 또는 GraphQL Project ID 목록
PTMORE_PHOENIX_PROJECTS_JSON=[]

# Phoenix 조회 설정
PTMORE_PHOENIX_TIMEOUT_SECONDS=30
PTMORE_PHOENIX_PAGE_SIZE=500
PTMORE_PHOENIX_FILTER_CONDITION=span_kind == 'CHAIN'
PTMORE_PHOENIX_SPAN_NAME_PREFIX=GaiA Input
