# PTMORE PKG Agent Portal 환경설정 예시
# 이 파일을 .env로 복사한 뒤 필요한 값만 입력합니다.
# API 키와 DB 비밀번호는 이 예시 파일에 저장하지 않습니다.
# example, CHANGE_ME 값은 실제 연결용 값이 아니므로 반드시 교체합니다.

# 로그인 방식
# 운영 app.py: production / 로컬 app_local.py: 아래 값과 무관하게 고정 사용자 사용
PTMORE_PORTAL_AUTH_MODE=production
# 운영 HCP Secret에만 입력: 임의의 긴 문자열로 교체
PTMORE_SSO_SESSION_SECRET=change-me-to-a-long-random-session-secret
# 운영 HTTPS 사용 시 true (기본 true)
PTMORE_SSO_SESSION_HTTPS_ONLY=true
# 운영 기본 관리자: 항상 관리자 권한을 가지며 MongoDB에 저장되지 않습니다.
# HCP Secret에 실제 사번/이름을 넣으세요. 이 명단은 웹에서 수정·삭제할 수 없습니다.
# 예: [{"employee_id":"2069026","name":"문봉건"}]
PTMORE_PORTAL_BOOTSTRAP_ADMINS_JSON=[]

# CUBE 봇 토큰과 GAIA 호출 키는 Portal에 넣지 않습니다.
# 각각 callback 서버와 Scheduler Worker의 HCP Secret에서 관리합니다.

# 메타데이터 등록은 실제 Flow API만 사용합니다.
PTMORE_METADATA_API_MODE=api

# 공통 메타데이터 API 주소 (사용 시 유형별 URL은 비워 둠)
# 예: https://langflow.example.skhynix.com/api/v1/run/metadata-authoring
PTMORE_METADATA_API_URL=https://langflow.example.skhynix.com/api/v1/run/metadata-authoring

# 유형별 Langflow Run API 주소
# 공통 주소 대신 Flow별 주소가 다를 때만 입력합니다.
# 예: https://langflow.example.skhynix.com/api/v1/run/metadata-driven-v5-domain-saving-rev-2
PTMORE_METADATA_TABLE_CATALOG_API_URL=
PTMORE_METADATA_MAIN_FLOW_FILTER_API_URL=
PTMORE_METADATA_DOMAIN_API_URL=

# API 인증 정보 (실제 값은 .env 또는 HCP Secret에 입력)
# Langflow Run API: x-api-key / GAIA External API: X-Gaia-Auth-Key
PTMORE_METADATA_API_AUTH_HEADER=x-api-key
PTMORE_METADATA_API_AUTH_KEY=lf_example_change_me
PTMORE_METADATA_API_BEARER_TOKEN=
PTMORE_METADATA_API_EXTRA_HEADERS_JSON={}

# API 호출 설정
PTMORE_METADATA_API_TIMEOUT_SECONDS=300
PTMORE_METADATA_API_VERIFY_TLS=true

# Flow 요청 형식 (일반적으로 langflow 사용)
PTMORE_METADATA_API_PAYLOAD_MODE=langflow
PTMORE_METADATA_API_INPUT_TYPE=chat
PTMORE_METADATA_API_OUTPUT_TYPE=any

# Flow 노드 이름을 변경했거나, 해당 Flow에 없는 optional 노드를 비활성화할 때 JSON으로 매핑 입력
# 현재 경량 03 Table Catalog Flow는 Snapshot Loader가 없으므로 Mongo tweak 사용 시 아래처럼 비웁니다.
# null도 같은 의미입니다. Writer와 API terminal은 기존 표시명을 그대로 사용합니다.
PTMORE_METADATA_FLOW_COMPONENT_MAP_JSON={"table_catalog":{"snapshot_loader":""}}

# Portal 설정·스케줄 저장 및 실제 메타데이터 조회용 MongoDB
# 예: mongodb://계정:비밀번호@호스트:27017/?authSource=admin
# Worker에도 동일한 URI, DB, 스케줄 컬렉션 이름을 입력합니다.
# GAIA API 호출 권한 사번은 관리자 설정 화면에서 관리됩니다.
MONGODB_URI=mongodb://ptmore_portal:CHANGE_ME@mongo.example.skhynix.com:27017/?authSource=admin
MONGODB_DATABASE=datagov_test
MONGODB_COLLECTION_PREFIX=agent_v4_test_

# 포털 관리·스케줄 컬렉션 이름
PTMORE_PORTAL_SETTINGS_COLLECTION=portal_settings
PTMORE_PORTAL_AUDIT_COLLECTION=portal_audit_log
PTMORE_SCHEDULE_COLLECTION=portal_schedules
PTMORE_SCHEDULE_RUN_COLLECTION=portal_schedule_runs
# Portal은 스케줄 등록 정보를 저장합니다. 실제 실행과 실행 이력 기록은
# gaia_cube_server/scheduler_worker_server가 같은 값으로 처리합니다.

# 실제 메타데이터 목록 조회 (읽기 전용, 기본 비활성)
PTMORE_METADATA_LIVE_READ_MODE=configured
# 실제 목록을 유형별로 지정할 때 사용합니다.
PTMORE_METADATA_LIVE_COLLECTION_MAP_JSON={"domain":"agent_v4_test_domain_items","table_catalog":"agent_v4_test_table_catalog_items","main_flow_filters":"agent_v4_test_main_flow_filters"}

# 등록 Flow에 컬렉션 이름을 직접 전달해야 할 때만 사용합니다.
PTMORE_METADATA_MONGODB_COLLECTION_MAP_JSON={"domain":"agent_v4_test_domain_items","table_catalog":"agent_v4_test_table_catalog_items","main_flow_filters":"agent_v4_test_main_flow_filters"}

# false: 원격 Flow의 MongoDB 설정 사용, true: 아래 MongoDB 정보를 Flow에 전달
PTMORE_METADATA_SEND_MONGODB_TWEAKS=false

# 대시보드 사용 이력은 실제 Phoenix에서 조회합니다.
PTMORE_USAGE_HISTORY_MODE=phoenix

# Phoenix 연결 정보 (실제 값은 .env 또는 비밀관리 도구에 입력)
# 예: http://gaia-phoenix.example.skhynix.com
PTMORE_PHOENIX_ENDPOINT=http://gaia-phoenix.example.skhynix.com
PTMORE_PHOENIX_API_KEY=phx_example_change_me

# 조회할 Phoenix 프로젝트 이름 또는 GraphQL Project ID 목록
# 예: ["프로젝트이름1", "프로젝트이름2"]
PTMORE_PHOENIX_PROJECTS_JSON=["my-gaia-project-a","my-gaia-project-b"]

# Phoenix 조회 설정
PTMORE_PHOENIX_TIMEOUT_SECONDS=30
PTMORE_PHOENIX_PAGE_SIZE=500
PTMORE_PHOENIX_FILTER_CONDITION=span_kind == 'CHAIN'
PTMORE_PHOENIX_SPAN_NAME_PREFIX=GaiA Input

# Phoenix는 최근 3주만 보관합니다. phoenix + configured이면 Portal 대시보드가
# MongoDB 보관 이력을 먼저 읽고, 당일(KST)과 최근 21일 중 아직 보관되지 않은 날짜만 Phoenix에서 갱신합니다.
# 처음 대시보드를 열면 최근 21일 전체를 보관소에 초기화합니다.
# disabled: Phoenix 최근 3주를 매번 조회 / configured: 대시보드 요청 기반 MongoDB 보관 사용
# 실제 운영에서는 phoenix + configured 조합을 사용합니다.
PTMORE_USAGE_HISTORY_ARCHIVE_MODE=configured
# Portal이 소유하는 사용 이력 보관 컬렉션입니다. 기존 메타데이터/스케줄 컬렉션과 겹치지 않게 둡니다.
PTMORE_USAGE_HISTORY_COLLECTION=portal_usage_history
# 활성 관리자만 Portal의 '최근 3주 전체 새로고침'으로 21일 전체를 다시 조회할 수 있습니다.
# 사용 이력 보관만을 위한 HCP Cron, 별도 Worker, 서버 간 동기화 Secret은 필요하지 않습니다.
