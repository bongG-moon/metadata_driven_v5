# HCP 일반 CUBE callback 서버 전용 설정
# Scheduler Worker는 별도 HCP 배포이며 이 파일을 공유하지 않습니다.
# Registered CUBE callback URL:
# http://aiu-pkg-prod-ai-api001-basic-dev.api.hcpd03.skhynix.com/api/v1/receiver
# The server accepts only POST /api/v1/receiver.

# Paste the complete GAIA Agent API URL. Do not enter a base URL or service ID.
GAIA_API_URL=PASTE_GAIA_API_URL_HERE
GAIA_AUTH_KEY=PASTE_GAIA_AUTH_KEY_HERE
GAIA_TIMEOUT_SECONDS=10

# CUBE response API
CUBE_SEND_URL=http://cube.skhynix.com:8888/legacy/richnotification
CUBE_BOT_ID=PASTE_CUBE_BOT_ID_HERE
CUBE_BOT_TOKEN=PASTE_CUBE_BOT_TOKEN_HERE
# Korean, Japanese, English, Chinese, other
CUBE_BOT_FROMUSERNAME_JSON=["PASTE_BOT_NAME_KOREAN","PASTE_BOT_NAME_JAPANESE","PASTE_BOT_NAME_ENGLISH","PASTE_BOT_NAME_CHINESE","PASTE_BOT_NAME_OTHER"]
CUBE_TIMEOUT_SECONDS=20

USER_ERROR_MESSAGE=요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요.
