# Copy this file to .env. Do not commit the real .env file.

# GAIA external Agent API
GAIA_BASE_URL=http://gaia.example.internal
GAIA_AUTH_KEY=PASTE_GAIA_AUTH_KEY_HERE
GAIA_SERVICE_ID=PASTE_DEFAULT_GAIA_SERVICE_ID_HERE
GAIA_TIMEOUT_SECONDS=10

# Optional: use different fixed GAIA Agents by CUBE channel.
# When this value is populated, its channel mapping has priority over
# GAIA_SERVICE_ID. Keep the JSON on a single line.
# CUBE_CHANNEL_GAIA_SERVICE_MAP_JSON={"CHANNEL_ID_A":"GAIA_SERVICE_ID_A","CHANNEL_ID_B":"GAIA_SERVICE_ID_B"}

# CUBE Rich Notification API
CUBE_SEND_URL=http://cube.example.internal/legacy/richnotification
CUBE_BOT_ID=PASTE_CUBE_BOT_ID_HERE
CUBE_BOT_TOKEN=PASTE_CUBE_BOT_TOKEN_HERE
CUBE_TIMEOUT_SECONDS=20

# Callback result values. Confirm these with the official CUBE contract.
CUBE_CALLBACK_SUCCESS_STATUS=success
CUBE_CALLBACK_IGNORED_STATUS=ignored

# This is sent through CUBE only if the GAIA request or final-answer
# extraction fails. Do not put internal exception text here.
USER_ERROR_MESSAGE=요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요.
