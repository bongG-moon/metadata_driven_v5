# PTMORE 독립 스케줄 Worker HCP 설정
# callback 서버와 별도 HCP 배포이므로, 필요한 값은 이 Worker의 HCP Secret에 다시 등록합니다.
# HCP 실행 파일: app.py (0.0.0.0:5000, /health, /ready)
# 실제 값은 HCP Secret 또는 배포 환경변수에 입력합니다.
# example, CHANGE_ME 값은 실제 연결용 값이 아니므로 반드시 교체합니다.

# 완성된 GAIA external API URL과 인증 키
# 예: https://gaia.example.skhynix.com/external
GAIA_API_URL=https://gaia.example.skhynix.com/external
GAIA_AUTH_KEY=gaia_example_change_me
GAIA_TIMEOUT_SECONDS=10

# CUBE Rich Notification 발송 정보
CUBE_SEND_URL=http://cube.skhynix.com:8888/legacy/richnotification
# 예: C0000979 / 실제 발급받은 토큰으로 교체
CUBE_BOT_ID=C0000000
CUBE_BOT_TOKEN=C0000000-example-token-change-me
# 한글, 일본어, 영어, 중문, 기타 순서의 실제 봇 표시명 5개
CUBE_BOT_FROMUSERNAME_JSON=["PTMORE PKG Agent","PTMORE PKG Agent","PTMORE PKG Agent","PTMORE PKG Agent","PTMORE PKG Agent"]
CUBE_TIMEOUT_SECONDS=20
USER_ERROR_MESSAGE=요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요.

# Portal과 공유하는 스케줄 MongoDB
# Portal의 MONGODB_URI, MONGODB_DATABASE와 반드시 같아야 합니다.
# 예: mongodb://계정:비밀번호@호스트:27017/?authSource=admin
MONGODB_URI=mongodb://ptmore_portal:CHANGE_ME@mongo.example.skhynix.com:27017/?authSource=admin
MONGODB_DATABASE=datagov_test
PTMORE_SCHEDULE_COLLECTION=portal_schedules
PTMORE_SCHEDULE_RUN_COLLECTION=portal_schedule_runs

# Worker 동작 설정
PTMORE_SCHEDULER_POLL_SECONDS=30
# GAIA_TIMEOUT_SECONDS + CUBE_TIMEOUT_SECONDS + 60초 이상
PTMORE_SCHEDULER_LEASE_SECONDS=900
PTMORE_SCHEDULER_BATCH_SIZE=20
PTMORE_SCHEDULER_MONGODB_TIMEOUT_MS=5000
# Worker 복제본을 여러 개 띄울 때 각 복제본마다 다르게 입력합니다.
PTMORE_SCHEDULER_WORKER_ID=ptmore-scheduler-worker-01
PTMORE_SCHEDULER_LOG_LEVEL=INFO
