# 이 파일을 .env로 복사하고 URI만 실제 값으로 변경하세요.
# 실제 .env는 Git이나 메일로 공유하지 마세요. 읽기 전용 MongoDB 계정을 권장합니다.
# 비밀번호의 @, :, / 등 예약 문자는 URL 인코딩해야 합니다.
MONGODB_URI="mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Phoenix 이력을 보관한 MongoDB 데이터베이스입니다.
MONGODB_DATABASE="datagov"

# Portal이 사용 이력을 적재한 컬렉션입니다.
PTMORE_USAGE_HISTORY_COLLECTION="portal_usage_history"

# 집계 기간/활성 기준은 실행 인자로 설정합니다(README.md 참고).
# .env는 자동으로 읽지 않으므로 안내된 dotenv 실행 명령을 사용하세요.
