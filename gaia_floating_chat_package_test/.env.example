# External Gateway의 도메인만 입력합니다. Vite 개발 서버가 /v2 요청을 이 주소로 전달합니다.
GAIA_EXTERNAL_GATEWAY_ORIGIN=http://gaia.api.skhynix.com

# HTTPS Gateway 인증서 검증 여부 (일반적으로 true)
GAIA_EXTERNAL_GATEWAY_VERIFY_SSL=true

# 실제 Agent External 경로입니다. Gateway 도메인은 위 설정으로 분리합니다.
VITE_GAIA_AGENT_URL=/v2/agents/031011/external

# AI Market에서 발급받은 External 인증키 (로컬 테스트 전용: 브라우저에 노출됩니다.)
VITE_GAIA_API_KEY=

# 실제 권한이 있는 사용자 사번과 테스트 세션입니다.
VITE_GAIA_USER_ID=2069026
VITE_GAIA_SESSION_ID=test_2069026

# floating 버튼 위치: left 또는 right
VITE_GAIA_FLOATING_POSITION=right
